{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "cyan"
    ],
    "text": {
      "base": "#e8eef8",
      "muted": "#aabbd1",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "#a8d0ff"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "#f5a742"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#16263d66",
        "high": "#182a45bb",
        "max": "#1d3252e6"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "#1b315477",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "transparent",
        "$focused": "#14274388",
        "$selected": "#28486c"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#55749b"
    },
    "scrollbar": {
      "base": "#6e8bb4"
    },
    "diff": {
      "text": {
        "added": "#a3d9bd",
        "removed": "#f2a6b0",
        "context": "#b8c9e0",
        "hunkHeader": "#91c6ff"
      },
      "background": {
        "added": "#14352d",
        "removed": "#402331",
        "context": "#0d1b2f"
      },
      "highlight": {
        "added": "#b8db87",
        "removed": "#e26a75"
      },
      "lineNumber": {
        "text": "#91a8c8",
        "background": {
          "added": "#112c26",
          "removed": "#331e28"
        }
      }
    },
    "syntax": {
      "comment": "#8da4c1",
      "keyword": "#c3a6f5",
      "function": "#91c6ff",
      "variable": "#e8eef8",
      "string": "#a3d9bd",
      "number": "#edbd91",
      "type": "#8ed9e3",
      "operator": "#b9cce5",
      "punctuation": "#aabbd1"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "#9ac8ff",
      "link": "#91c6ff",
      "linkText": "#8ed9e3",
      "code": "$hue.green.200",
      "blockQuote": "#e5c07b",
      "emphasis": "#e5c07b",
      "strong": "#eaf2ff",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "#0d1b2feb",
        "raised": {
          "base": "#162a43",
          "high": "#223d5e",
          "max": "#2c5078"
        },
        "action": {
          "primary": {
            "base": "transparent",
            "$hovered": "#223d5e",
            "$selected": "#294b72"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#f4f7fc",
        "200": "#e8eef8",
        "300": "#c3d2e7",
        "400": "#aabbd1",
        "500": "#6e87a9",
        "600": "#29405e",
        "700": "#192d47",
        "800": "#0d1b2f",
        "900": "#07111f"
      },
      "red": {
        "100": "#fd7e87",
        "200": "#e06c75",
        "300": "#c35a63",
        "400": "#a74952",
        "500": "#8c3941",
        "600": "#722931",
        "700": "#591921",
        "800": "#410a13",
        "900": "#280207"
      },
      "orange": {
        "100": "#fddac5",
        "200": "#fab283",
        "300": "#d8976c",
        "400": "#b67c56",
        "500": "#966341",
        "600": "#774a2c",
        "700": "#593319",
        "800": "#3d1d06",
        "900": "#1f0b01"
      },
      "green": {
        "100": "#96f7a7",
        "200": "#7fd88f",
        "300": "#68b977",
        "400": "#539c61",
        "500": "#3d7f4b",
        "600": "#296336",
        "700": "#144922",
        "800": "#00300f",
        "900": "#011705"
      },
      "cyan": {
        "100": "#68d0dd",
        "200": "#56b6c2",
        "300": "#449da7",
        "400": "#33848e",
        "500": "#226c75",
        "600": "#0f555d",
        "700": "#093e44",
        "800": "#02292e",
        "900": "#001518"
      },
      "blue": {
        "100": "#82b4fb",
        "200": "#5c9cf5",
        "300": "#4c86d6",
        "400": "#3c70b8",
        "500": "#2c5b9b",
        "600": "#1d477f",
        "700": "#0f3364",
        "800": "#02214a",
        "900": "#01112b"
      },
      "purple": {
        "100": "#b38ff4",
        "200": "#9d7cd8",
        "300": "#8869bd",
        "400": "#7357a2",
        "500": "#5f4688",
        "600": "#4b356f",
        "700": "#392557",
        "800": "#271640",
        "900": "#17072b"
      },
      "accent": "$hue.blue",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray",
      "yellow": "$hue.orange"
    }
  }
}
